{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A construction material order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "productName": { "type": "string" },
              "quantity": { "type": "number" },
              "unit": { "type": "string" }
            }
          }
        },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "ready", "scheduled", "in_transit", "delivered", "cancelled"]
        },
        "deliveryAddress": { "type": "string" },
        "deliveryLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "currentLat": { "type": "number", "description": "Current real-time latitude" },
        "currentLng": { "type": "number", "description": "Current real-time longitude" },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "specialOrder": { "type": "boolean" },
        "totalAmount": { "type": "number" }
      },
      "required": ["customerId", "items", "status", "createdAt"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "A building material product in stock",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "minLevel": { "type": "number" },
        "price": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["name", "quantity", "unit"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Delivery driver information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "busy", "offline"] },
        "currentOrderId": { "type": "string" },
        "currentLat": { "type": "number" },
        "currentLng": { "type": "number" }
      },
      "required": ["name", "status"]
    },
    "AILog": {
      "title": "AI Interaction Log",
      "description": "Log of AI assistant interactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "response": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "orders": {
      "schema": "Order",
      "description": "Active and past construction orders"
    },
    "inventory": {
      "schema": "InventoryItem",
      "description": "Stock of materials"
    },
    "customers": {
      "schema": "Customer",
      "description": "Client database"
    },
    "drivers": {
      "schema": "Driver",
      "description": "Fleet information"
    },
    "ai_logs": {
      "schema": "AILog",
      "description": "AI trace logs"
    },
    "brands": { "schema": "object", "description": "Brand management" },
    "bridge_sessions": { "schema": "object", "description": "Integration sessions" },
    "categories": { "schema": "object", "description": "Product categories" },
    "chats": { "schema": "object", "description": "Customer support chats" },
    "encyclopedia_categories": { "schema": "object", "description": "Knowledge base categories" },
    "encyclopedia_items": { "schema": "object", "description": "Knowledge base articles" },
    "internal_team_chats": { "schema": "object", "description": "Team communication" },
    "morning_reports": { "schema": "object", "description": "Daily operational summaries" },
    "office_messages": { "schema": "object", "description": "HQ announcements" },
    "reminders": { "schema": "object", "description": "Task reminders" },
    "sales": { "schema": "object", "description": "Sales records" },
    "user_magic_pages": { "schema": "object", "description": "Custom user landing pages" },
    "user_settings": { "schema": "object", "description": "User preferences" },
    "users": { "schema": "object", "description": "System users" }
  }
}
