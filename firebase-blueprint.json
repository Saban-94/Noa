{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A construction material order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object", "properties": { "productId": { "type": "string" }, "productName": { "type": "string" }, "quantity": { "type": "number" }, "unit": { "type": "string" } } } },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "ready", "scheduled", "in_transit", "delivered", "cancelled"] },
        "deliveryAddress": { "type": "string" },
        "deliveryLocation": { "type": "object", "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } } },
        "currentLat": { "type": "number" },
        "currentLng": { "type": "number" },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "specialOrder": { "type": "boolean" },
        "totalAmount": { "type": "number" }
      },
      "required": ["customerId", "items", "status", "createdAt"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Stock of materials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "minLevel": { "type": "number" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "sku": { "type": "string" }
      },
      "required": ["name", "quantity", "unit"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Client database",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "customerNumber": { "type": "string" }
      },
      "required": ["name"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Delivery driver information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "busy", "offline"] },
        "currentOrderId": { "type": "string" },
        "currentLat": { "type": "number" },
        "currentLng": { "type": "number" }
      },
      "required": ["name", "status"]
    },
    "MorningReport": {
      "title": "Morning Report",
      "description": "Daily operational summary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "orderIds": { "type": "array", "items": { "type": "string" } },
        "reportText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AILog": {
      "title": "AI Interaction Log",
      "description": "Log of AI assistant interactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "prompt": { "type": "string" },
        "response": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "orders": { "schema": "Order" },
    "inventory": { "schema": "InventoryItem" },
    "customers": { "schema": "Customer" },
    "drivers": { "schema": "Driver" },
    "morning_reports": { "schema": "MorningReport" },
    "ai_logs": { "schema": "AILog" },
    "sales": { "schema": "object", "description": "Sales records" },
    "office_messages": { "schema": "object", "description": "HQ announcements" },
    "chats": { "schema": "object", "description": "Customer support chats" },
    "reminders": { "schema": "object", "description": "Task reminders" }
  }
}
